# Copia in .env (globale) oppure in projects/<nome>/credentials.env (per-progetto).
# Servono solo le chiavi dei provider che usi.

# OpenAI (gpt-image-1, Sora)
OPENAI_API_KEY=

# x.ai / Grok (endpoint OpenAI-compatible)
XAI_API_KEY=

# OpenRouter (aggrega Gemini, Flux, ecc. — endpoint OpenAI-compatible)
OPENROUTER_API_KEY=

# Google AI Studio (Imagen, Nano Banana, Veo — API Gemini nativa)
GEMINI_API_KEY=
