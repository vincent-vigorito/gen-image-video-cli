# Copia in .env (cartella corrente), in projects/<nome>/credentials.env (per-progetto)
# oppure in ~/.config/giv/credentials.env (per usare giv da qualsiasi directory).
# Ordine: env di processo → ./credentials.env → ./.env → ~/.config/giv/credentials.env.
# Servono solo le chiavi dei provider che usi.

# Provider usato senza --provider: gemini | openai | xai | openrouter | fal (default: gemini)
# GIV_PROVIDER=openrouter

# OpenAI (immagini gpt-image-*; nessuna API video)
OPENAI_API_KEY=

# x.ai / Grok (immagini e video con ultimo fotogramma e riferimenti, endpoint OpenAI-compatible)
XAI_API_KEY=

# OpenRouter (aggrega Gemini, OpenAI, ByteDance, Flux, ecc. — immagini e video, anche Veo e Gemini Omni;
# capacità e prezzi dei video letti da /videos/models)
OPENROUTER_API_KEY=

# Google AI Studio (immagini Nano Banana — API Gemini nativa; nessun video: Veo è spento)
GEMINI_API_KEY=

# fal (video Kling 3 Pro e Seedance 2.0, giv avatar; immagini e voci locali caricate sullo storage di fal)
FAL_KEY=
