# binari generati
bin/*
!bin/.gitkeep

# output media generati
out/*
!out/.gitkeep

# credenziali — MAI nel repo
.env
credentials.env

# materiali interni per-progetto (credenziali, asset, riferimenti clienti)
projects/*
!projects/.gitkeep

# registro locale delle generazioni
giv-log.jsonl

# macOS
.DS_Store
